<?xml version="1.0"?>
<!-- If your plugin defines device types, you can define them here.-->

<Devices>
    <!-- This device illustrates how a plugin can inherit Indigo's sprinkler
    device behavior including active zone states, and sprinkler actions, and
    will support Indigo and Indigo Touch's native UI for sprinkler type devices.
    -->
    <Device type="sprinkler" id="sprinkler">
        <Name>Netro Sprinkler Controller</Name>
        <ConfigUI>
            <Field id="addressLabel" type="label">
                <Label>Enter the serial number for this Netro controller. If you have multiple controllers, create a separate device for each one.</Label>
            </Field>
            <Field id="address" type="textfield">
                <Label>Controller Serial Number:</Label>
            </Field>
            <Field id="addressHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
                <Label>Found in the Netro mobile app under Settings (e.g., a4cf12b8d5e2).</Label>
            </Field>
            <Field id="sep_api" type="separator"/>
            <Field id="apiKeyLabel" type="label">
                <Label>API v2 (Optional): Enter an API key for more secure authentication. Get your key at netrohome.com → Account → API Key.</Label>
            </Field>
            <Field id="apiKey" type="textfield" defaultValue="">
                <Label>API Key (v2):</Label>
            </Field>
            <Field id="apiKeyHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
                <Label>Leave blank to continue using v1 (serial number authentication).</Label>
            </Field>
            <Field id="sep1" type="separator"/>
            <Field type="menu" id="units" defaultValue="US">
                <Label>Display units:</Label>
                <List>
                    <Option value="US">US (°F, inches)</Option>
                    <Option value="METRIC">Metric (°C, mm)</Option>
                </List>
            </Field>
            <Field type="checkbox" id="PumpControlOn" defaultValue="false" hidden="true">
                <Label/>
            </Field>
            <Field type="textfield" id="apiVersion" hidden="true">
                <Label/>
            </Field>
        </ConfigUI>
        <States>
            <State id="serial">
                <ValueType>String</ValueType>
                <TriggerLabel>Id</TriggerLabel>
                <ControlPageLabel>Id</ControlPageLabel>
            </State>
            <State id="id">
                <ValueType>String</ValueType>
                <TriggerLabel>Id</TriggerLabel>
                <ControlPageLabel>Id</ControlPageLabel>
            </State>
            <State id="token_remaining">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Tokens Remaining</TriggerLabel>
                <ControlPageLabel>Tokens Remaining</ControlPageLabel>
            </State>
            <State id="token_reset">
                <ValueType>String</ValueType>
                <TriggerLabel>Token reset time</TriggerLabel>
                <ControlPageLabel>Token reset time</ControlPageLabel>
            </State>
            <State id="api_version">
                <ValueType>String</ValueType>
                <TriggerLabel>API Version</TriggerLabel>
                <ControlPageLabel>API Version</ControlPageLabel>
            </State>
            <State id="sw_version">
                <ValueType>String</ValueType>
                <TriggerLabel>Firmware Version</TriggerLabel>
                <ControlPageLabel>Firmware Version</ControlPageLabel>
            </State>
            <State id="time">
                <ValueType>String</ValueType>
                <TriggerLabel>Refresh time</TriggerLabel>
                <ControlPageLabel>Refresh time</ControlPageLabel>
            </State>
            <State id="last_active">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Active Time</TriggerLabel>
                <ControlPageLabel>Last Active Time</ControlPageLabel>
            </State>
            <State id="activeSchedule">
                <ValueType>String</ValueType>
                <TriggerLabel>Active Netro Schedule</TriggerLabel>
                <ControlPageLabel>Active Netro Schedule</ControlPageLabel>
            </State>
            <State id="nextScheduleTime">
                <ValueType>String</ValueType>
                <TriggerLabel>Next Schedule Start Time</TriggerLabel>
                <ControlPageLabel>Next Schedule Start Time</ControlPageLabel>
            </State>
            <State id="nextScheduleZone">
                <ValueType>String</ValueType>
                <TriggerLabel>Next Schedule Zone</TriggerLabel>
                <ControlPageLabel>Next Schedule Zone</ControlPageLabel>
            </State>
            <State id="nextScheduleSource">
                <ValueType>String</ValueType>
                <TriggerLabel>Next Schedule Type</TriggerLabel>
                <ControlPageLabel>Next Schedule Type</ControlPageLabel>
            </State>
            <State id="nextScheduleDuration">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Next Schedule Duration (minutes)</TriggerLabel>
                <ControlPageLabel>Next Schedule Duration (minutes)</ControlPageLabel>
            </State>
            <State id="name">
                <ValueType>String</ValueType>
                <TriggerLabel>Name</TriggerLabel>
                <ControlPageLabel>Name</ControlPageLabel>
            </State>
            <State id="inStandbyMode">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>In Standby Mode</TriggerLabel>
                <ControlPageLabel>In Standby Mode</ControlPageLabel>
            </State>
            <State id="serialNumber">
                <ValueType>String</ValueType>
                <TriggerLabel>Serial Number</TriggerLabel>
                <ControlPageLabel>Serial Number</ControlPageLabel>
            </State>
            <State id="status">
                <ValueType>String</ValueType>
                <TriggerLabel>Status</TriggerLabel>
                <ControlPageLabel>Status</ControlPageLabel>
            </State>
            <State id="weather_condition">
                <ValueType>String</ValueType>
                <TriggerLabel>Weather Condition</TriggerLabel>
                <ControlPageLabel>Weather Condition</ControlPageLabel>
            </State>
            <State id="weather_temperature">
                <ValueType>Number</ValueType>
                <TriggerLabel>Weather Temperature</TriggerLabel>
                <ControlPageLabel>Weather Temperature</ControlPageLabel>
            </State>
            <State id="weather_humidity">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Weather Humidity (%)</TriggerLabel>
                <ControlPageLabel>Weather Humidity (%)</ControlPageLabel>
            </State>
            <State id="weather_rain">
                <ValueType>Number</ValueType>
                <TriggerLabel>Weather Precipitation (mm/hr)</TriggerLabel>
                <ControlPageLabel>Weather Precipitation (mm/hr)</ControlPageLabel>
            </State>
            <State id="weather_rain_prob">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Weather Rain Probability (%)</TriggerLabel>
                <ControlPageLabel>Weather Rain Probability (%)</ControlPageLabel>
            </State>
            <State id="weather_wind_speed">
                <ValueType>Number</ValueType>
                <TriggerLabel>Weather Wind Speed (m/s)</TriggerLabel>
                <ControlPageLabel>Weather Wind Speed (m/s)</ControlPageLabel>
            </State>
            <State id="weather_pressure">
                <ValueType>Number</ValueType>
                <TriggerLabel>Weather Pressure (hPa)</TriggerLabel>
                <ControlPageLabel>Weather Pressure (hPa)</ControlPageLabel>
            </State>
            <State id="weather_updated">
                <ValueType>String</ValueType>
                <TriggerLabel>Weather Last Updated</TriggerLabel>
                <ControlPageLabel>Weather Last Updated</ControlPageLabel>
            </State>
        </States>
    </Device>
    <Device type="sensor" subType="kSensorDeviceSubType.Humidity, ui=Plant Moisture Sensor"  id="Whisperer">
        <Name>Whisperer Plant Sensor</Name>
        <ConfigUI>
            <Field id="addressLabel" type="label">
                <Label>Enter the serial number for this Whisperer soil sensor.</Label>
            </Field>
            <Field id="address" type="textfield">
                <Label>Sensor Serial Number:</Label>
            </Field>
            <Field id="addressHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
                <Label>Found in the Netro mobile app under Settings.</Label>
            </Field>
            <Field id="sep_api" type="separator"/>
            <Field id="apiKeyLabel" type="label">
                <Label>API v2 (Optional): Enter an API key for more secure authentication. Get your key at netrohome.com → Account → API Key.</Label>
            </Field>
            <Field id="apiKey" type="textfield" defaultValue="">
                <Label>API Key (v2):</Label>
            </Field>
            <Field id="apiKeyHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
                <Label>Leave blank to continue using v1 (serial number authentication).</Label>
            </Field>
            <Field id="sep1" type="separator"/>
            <Field id="SupportsOnState" type="checkbox" defaultValue="false">
                <Label>Show ON/OFF state:</Label>
            </Field>
            <Field id="SupportsSensorValue" type="checkbox" defaultValue="true">
                <Label>Show sensor value state:</Label>
            </Field>
            <Field id="SupportsStatusRequest" type="checkbox" defaultValue="true">
                <Label>Enable status request / refresh button:</Label>
            </Field>

        </ConfigUI>
        <States>
            <State id="humidity">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Humidity</TriggerLabel>
                <ControlPageLabel>Humidity</ControlPageLabel>
            </State>
            <State id="temperature">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Temperature</TriggerLabel>
                <ControlPageLabel>Temperature</ControlPageLabel>
            </State>
            <State id="soilTemperature">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Soil Temperature</TriggerLabel>
                <ControlPageLabel>Soil Temperature</ControlPageLabel>
            </State>
            <State id="soilMoisture">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Soil Moisture</TriggerLabel>
                <ControlPageLabel>Soil Moisture</ControlPageLabel>
            </State>
            <State id="sunlight">
                <ValueType>Number</ValueType>
                <TriggerLabel>Sunlight (lux)</TriggerLabel>
                <ControlPageLabel>Sunlight (lux)</ControlPageLabel>
            </State>
            <State id="readingID">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Sensor Reading ID</TriggerLabel>
                <ControlPageLabel>Sensor Reading ID</ControlPageLabel>
            </State>
            <State id="readingTime">
                <ValueType>String</ValueType>
                <TriggerLabel>Sensor Reading Time</TriggerLabel>
                <ControlPageLabel>Sensor Reading ID</ControlPageLabel>
            </State>
            <State id="readingLocalDate">
                <ValueType>String</ValueType>
                <TriggerLabel>Sensor Reading Local Date</TriggerLabel>
                <ControlPageLabel>Sensor Reading Local Date</ControlPageLabel>
            </State>
            <State id="readingLocalTime">
                <ValueType>String</ValueType>
                <TriggerLabel>Sensor Reading Local Time</TriggerLabel>
                <ControlPageLabel>Sensor Reading Local Time</ControlPageLabel>
            </State>
            <State id="id">
                <ValueType>String</ValueType>
                <TriggerLabel>Sensor id</TriggerLabel>
                <ControlPageLabel>Sensor id</ControlPageLabel>
            </State>
            <State id="serial">
                <ValueType>String</ValueType>
                <TriggerLabel>Sensor id</TriggerLabel>
                <ControlPageLabel>Sensor id</ControlPageLabel>
            </State>
            <State id="token_remaining">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Sensor id</TriggerLabel>
                <ControlPageLabel>Sensor id</ControlPageLabel>
            </State>
            <State id="last_active">
                <ValueType>String</ValueType>
                <TriggerLabel>Sensor id</TriggerLabel>
                <ControlPageLabel>Sensor id</ControlPageLabel>
            </State>
            <State id="token_reset">
                <ValueType>String</ValueType>
                <TriggerLabel>Sensor id</TriggerLabel>
                <ControlPageLabel>Sensor id</ControlPageLabel>
            </State>
            <State id="time">
                <ValueType>String</ValueType>
                <TriggerLabel>Sensor id</TriggerLabel>
                <ControlPageLabel>Sensor id</ControlPageLabel>
            </State>
            <State id="api_last_active">
                <ValueType>String</ValueType>
                <TriggerLabel>Sensor id</TriggerLabel>
                <ControlPageLabel>Sensor id</ControlPageLabel>
            </State>
            <State id="sensor_last_active">
                <ValueType>String</ValueType>
                <TriggerLabel>Sensor id</TriggerLabel>
                <ControlPageLabel>Sensor id</ControlPageLabel>
            </State>
        </States>
        <UiDisplayStateId>soilMoisture</UiDisplayStateId>
    </Device>
    <Device type="custom" id="zone">
        <Name>Netro Zone</Name>
        <ConfigUI>
            <Field id="parentDeviceId" type="textfield" hidden="true">
                <Label/>
            </Field>
            <Field id="zoneNumber" type="textfield" hidden="true">
                <Label/>
            </Field>
            <Field id="sep_sensor" type="separator"/>
            <Field id="sensorLabel" type="label">
                <Label>Soil Moisture Source</Label>
            </Field>
            <Field id="linkedWhispererDeviceId" type="menu" defaultValue="">
                <Label>Paired Whisperer:</Label>
                <List class="self" method="getWhispererDevices" dynamicReload="true"/>
            </Field>
            <Field id="sensorHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
                <Label>When paired, the zone's moisture state mirrors the Whisperer's soil reading (if fresh within 12 hours). Otherwise, it shows Netro's daily forecast. The forecast is always available separately as the "Moisture Forecast" state.</Label>
            </Field>
        </ConfigUI>
        <States>
            <State id="moisture">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Moisture Level (%)</TriggerLabel>
                <ControlPageLabel>Moisture Level (%)</ControlPageLabel>
            </State>
            <State id="moistureForecast">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Moisture Forecast (%)</TriggerLabel>
                <ControlPageLabel>Moisture Forecast (%)</ControlPageLabel>
            </State>
            <State id="enabled">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Zone Enabled</TriggerLabel>
                <ControlPageLabel>Zone Enabled</ControlPageLabel>
            </State>
            <State id="smartMode">
                <ValueType>String</ValueType>
                <TriggerLabel>Smart Mode</TriggerLabel>
                <ControlPageLabel>Smart Mode</ControlPageLabel>
            </State>
            <State id="isIrrigating">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Currently Irrigating</TriggerLabel>
                <ControlPageLabel>Currently Irrigating</ControlPageLabel>
            </State>
            <State id="lastWateringStart">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Watering Start</TriggerLabel>
                <ControlPageLabel>Last Watering Start</ControlPageLabel>
            </State>
            <State id="lastWateringEnd">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Watering End</TriggerLabel>
                <ControlPageLabel>Last Watering End</ControlPageLabel>
            </State>
            <State id="lastWateringSource">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Watering Source</TriggerLabel>
                <ControlPageLabel>Last Watering Source</ControlPageLabel>
            </State>
            <State id="lastWateringStatus">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Watering Status</TriggerLabel>
                <ControlPageLabel>Last Watering Status</ControlPageLabel>
            </State>
            <State id="nextWateringStart">
                <ValueType>String</ValueType>
                <TriggerLabel>Next Watering Start</TriggerLabel>
                <ControlPageLabel>Next Watering Start</ControlPageLabel>
            </State>
            <State id="nextWateringEnd">
                <ValueType>String</ValueType>
                <TriggerLabel>Next Watering End</TriggerLabel>
                <ControlPageLabel>Next Watering End</ControlPageLabel>
            </State>
            <State id="nextWateringSource">
                <ValueType>String</ValueType>
                <TriggerLabel>Next Watering Source</TriggerLabel>
                <ControlPageLabel>Next Watering Source</ControlPageLabel>
            </State>
        </States>
        <UiDisplayStateId>moisture</UiDisplayStateId>
    </Device>
</Devices>
