<?xml version="1.0"?>
<PluginConfig>
    <Field id="topLabel" type="label">
        <Label>Configure your Netro devices by creating separate device instances for each controller or sensor. Each device will have its own serial number configured in the device settings. Note: Netro's 2000 calls/day limit is shared across all your devices.</Label>
    </Field>

    <Field id="sep1" type="separator"/>

    <!-- Polling Intervals -->
    <Field id="pollingLabel" type="label" fontColor="blue">
        <Label>Polling Intervals</Label>
    </Field>
    <Field id="pollingDescription" type="label" fontSize="small" fontColor="darkgray">
        <Label>Control how often each type of data is fetched from the Netro API. Netro allows 2000 API calls/day shared across all devices. Lower intervals use more calls. The defaults are tuned for 2 controllers + 7 sensors.</Label>
    </Field>

    <!-- Events Interval -->
    <Field id="eventsInterval" type="textfield" defaultValue="5">
        <Label>Events interval (minutes):</Label>
    </Field>
    <Field id="eventsIntervalLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
        <Label>Online/offline device events (v2 API only). 1 call per controller. Default: 5 min.</Label>
    </Field>

    <!-- Device Info Interval -->
    <Field id="deviceInfoInterval" type="textfield" defaultValue="10">
        <Label>Device info interval (minutes):</Label>
    </Field>
    <Field id="deviceInfoIntervalLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
        <Label>Device status, firmware version, token count. 1 call per controller. Default: 10 min.</Label>
    </Field>

    <!-- Moistures Interval -->
    <Field id="moisturesInterval" type="textfield" defaultValue="10">
        <Label>Moistures interval (minutes):</Label>
    </Field>
    <Field id="moisturesIntervalLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
        <Label>Zone moisture levels. 1 call per controller. Default: 10 min. Note: will not fire more often than the Device info interval.</Label>
    </Field>

    <!-- Schedules Interval -->
    <Field id="schedulesInterval" type="textfield" defaultValue="30">
        <Label>Schedules interval (minutes):</Label>
    </Field>
    <Field id="schedulesIntervalLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
        <Label>Upcoming watering schedules. 1 call per controller. Default: 30 min. Note: will not fire more often than the Device info interval.</Label>
    </Field>

    <!-- Sensor Interval -->
    <Field id="sensorInterval" type="textfield" defaultValue="30">
        <Label>Sensor interval (minutes):</Label>
    </Field>
    <Field id="sensorIntervalLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
        <Label>Whisperer soil sensor readings. 1 call per sensor. Default: 30 min.</Label>
    </Field>

    <Field id="sep2" type="separator"/>

    <!-- API Timeout -->
    <Field id="apiTimeout" type="textfield" defaultValue="5">
        <Label>API Call Timeout (seconds):</Label>
    </Field>
    <Field id="timeoutLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
        <Label>Number of seconds to wait for API responses. Default is 5 seconds.</Label>
    </Field>

    <Field id="sep3" type="separator"/>

    <!-- Max Zone Runtime -->
    <Field id="maxZoneRunTime" type="textfield" defaultValue="3600">
        <Label>Max Zone Runtime (seconds):</Label>
    </Field>
    <Field id="maxZoneLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
        <Label>Maximum runtime per zone in seconds. Default is 3600 (1 hour). Valid range: 60-10800 seconds.</Label>
    </Field>

    <Field id="sep4" type="separator"/>

    <!-- Tomorrow.io Weather Integration -->
    <Field id="weatherLabel" type="label" fontColor="blue">
        <Label>Tomorrow.io Weather Integration</Label>
    </Field>
    <Field id="weatherDescription" type="label" fontSize="small" fontColor="darkgray">
        <Label>Automatically fetch weather from Tomorrow.io and report it to your Netro devices. This overrides Netro's built-in weather data for smarter watering schedules. Get a free API key at tomorrow.io.</Label>
    </Field>

    <Field id="tomorrowEnabled" type="checkbox" defaultValue="false">
        <Label>Enable Tomorrow.io weather:</Label>
        <Description>Fetch and report weather automatically</Description>
    </Field>

    <Field id="tomorrowApiKey" type="textfield" defaultValue="" visibleBindingId="tomorrowEnabled" visibleBindingValue="true">
        <Label>Tomorrow.io API Key:</Label>
    </Field>
    <Field id="tomorrowApiKeyLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true" visibleBindingId="tomorrowEnabled" visibleBindingValue="true">
        <Label>Your Tomorrow.io API key from your account dashboard.</Label>
    </Field>

    <Field id="tomorrowLocation" type="textfield" defaultValue="" visibleBindingId="tomorrowEnabled" visibleBindingValue="true">
        <Label>Location (lat,lon):</Label>
    </Field>
    <Field id="tomorrowLocationLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true" visibleBindingId="tomorrowEnabled" visibleBindingValue="true">
        <Label>Latitude and longitude, e.g. "42.3478,-71.0466". You can also use a place name like "Boston, MA".</Label>
    </Field>

    <Field id="weatherUpdateInterval" type="textfield" defaultValue="30" visibleBindingId="tomorrowEnabled" visibleBindingValue="true">
        <Label>Weather update interval (minutes):</Label>
    </Field>
    <Field id="weatherIntervalLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true" visibleBindingId="tomorrowEnabled" visibleBindingValue="true">
        <Label>How often to fetch current weather. Default: 30 min. Minimum: 10 min.</Label>
    </Field>

    <Field id="forecastInterval" type="textfield" defaultValue="240" visibleBindingId="tomorrowEnabled" visibleBindingValue="true">
        <Label>Forecast interval (minutes):</Label>
    </Field>
    <Field id="forecastIntervalLabel" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true" visibleBindingId="tomorrowEnabled" visibleBindingValue="true">
        <Label>How often to fetch 5-day forecast. Uses 6 Netro calls per controller. Default: 240 min (4 hours). Minimum: 60 min.</Label>
    </Field>

    <Field id="sep5" type="separator"/>

    <!-- Debug Logging -->
    <Field id="showDebugInfo" type="checkbox" defaultValue="false">
        <Label>Enable debug logging:</Label>
        <Description>Show detailed API calls in Event Log</Description>
    </Field>
</PluginConfig>
