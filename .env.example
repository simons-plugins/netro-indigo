# Netro API Configuration for Local Testing
# Copy this file to .env and add your real values
# DO NOT commit .env to git (it's in .gitignore)

# Your Netro controller serial number (found in Netro mobile app)
NETRO_SERIAL=your_controller_serial_here

# Optional: Whisperer sensor serial number
NETRO_SENSOR_SERIAL=your_sensor_serial_here

# API timeout in seconds (default: 5)
API_TIMEOUT=5
